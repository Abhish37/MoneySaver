# ============================================================
# MoneySaver (SaverStack) — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in the actual values.
#   cp .env.example .env.local
#
# ⚠️  NEVER commit your .env.local file to version control.
#     .env*.local is already listed in .gitignore.
#
# Tech Stack: Next.js 14 + Neon PostgreSQL + Drizzle ORM
#             + Clerk Auth + Upstash Redis + AWS S3
#             + Google Cloud Vision + Sentry + PostHog
# ============================================================

# ------------------------------------------------------------
# APP CONFIG
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=
NODE_ENV=

# ------------------------------------------------------------
# DATABASE — Neon PostgreSQL (Serverless)
# ------------------------------------------------------------
# Get from: https://console.neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ------------------------------------------------------------
# AUTHENTICATION — Clerk
# ------------------------------------------------------------
# Get from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ------------------------------------------------------------
# CACHE & RATE LIMITING — Upstash Redis
# ------------------------------------------------------------
# Get from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------
# OCR — Google Cloud Vision API
# ------------------------------------------------------------
# Get from: https://console.cloud.google.com/apis/library/vision.googleapis.com
# Service account key (JSON string, base64 encoded for env var)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_CLIENT_EMAIL=
GOOGLE_CLOUD_PRIVATE_KEY=

# ------------------------------------------------------------
# FILE STORAGE — AWS S3 (Ephemeral OCR Uploads)
# ------------------------------------------------------------
# Bucket should have a 15-minute lifecycle expiration policy
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=

# ------------------------------------------------------------
# AFFILIATE NETWORKS
# ------------------------------------------------------------
# EarnKaro / Cuelinks — Primary affiliate feed
EARNKARO_API_KEY=
EARNKARO_API_URL=
CUELINKS_API_KEY=
CUELINKS_API_URL=

# CashKaro — Secondary affiliate network
CASHKARO_API_KEY=

# ------------------------------------------------------------
# CRON JOBS — Security
# ------------------------------------------------------------
# Secret to authorize the /api/cron/refresh-coupons endpoint
# Generate: openssl rand -hex 32
CRON_SECRET=

# ------------------------------------------------------------
# MONITORING & ANALYTICS
# ------------------------------------------------------------
# Sentry — Error tracking
# Get from: https://sentry.io
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog — Product analytics & user events
# Get from: https://app.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ------------------------------------------------------------
# OPTIONAL: GIFT CARD AFFILIATES
# ------------------------------------------------------------
# Gyftr / Zave affiliate redirect base URLs (AMD-05: redirect only, no API)
GYFTR_AFFILIATE_BASE_URL=
ZAVE_AFFILIATE_BASE_URL=

# ------------------------------------------------------------
# OPTIONAL: AFFILIATE LINK SECURITY
# ------------------------------------------------------------
# HMAC secret for signing affiliate redirect tokens
# Generate: openssl rand -hex 32
AFFILIATE_HMAC_SECRET=
